{
  "$schema": "https://raw.githubusercontent.com/openwebide/plugins/main/schemas/plugin.schema.json",
  "schemaVersion": 1,
  "publisher": "openwebide",
  "name": "html",
  "version": "0.2.0",
  "displayName": "HTML",
  "description": "HTML syntax and code intelligence through the HTML language server on the project execution host.",
  "license": "MIT",
  "compatibility": {
    "pluginApi": 7
  },
  "readme": "README.md",
  "executable": {
    "manifest": "Cargo.toml",
    "library": "language_html",
    "sdkVersion": "0.1.0",
    "capabilities": []
  },
  "contributions": {
    "skills": [],
    "languages": [
      {
        "id": "html",
        "name": "HTML",
        "extensions": [
          "html",
          "htm"
        ],
        "configuration": {
          "blockComment": {
            "open": "<!--",
            "close": "-->"
          }
        },
        "features": {
          "syntax": true,
          "folding": true,
          "structure": true,
          "languageServer": {
            "command": "vscode-html-language-server",
            "args": [
              "--stdio"
            ],
            "rootMarkers": [
              "package.json",
              ".git"
            ],
            "languageId": "html",
            "initializationOptions": {
              "provideFormatter": true
            }
          }
        }
      }
    ],
    "context": false
  }
}
