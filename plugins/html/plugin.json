{
  "$schema": "https://raw.githubusercontent.com/openwebide/plugins/main/schemas/plugin.schema.json",
  "schemaVersion": 1,
  "publisher": "openwebide",
  "name": "html",
  "version": "0.1.0",
  "displayName": "HTML",
  "description": "Syntax, folding, source structure and editing rules for HTML.",
  "license": "MIT",
  "compatibility": {
    "pluginApi": 5
  },
  "readme": "README.md",
  "executable": {
    "manifest": "Cargo.toml",
    "library": "language_html",
    "sdkVersion": "0.1.0",
    "capabilities": []
  },
  "contributions": {
    "skills": [],
    "languages": [
      {
        "id": "html",
        "name": "HTML",
        "extensions": [
          "html",
          "htm"
        ],
        "configuration": {
          "blockComment": {
            "open": "<!--",
            "close": "-->"
          }
        },
        "features": {
          "syntax": true,
          "folding": true,
          "structure": true
        }
      }
    ]
  }
}
