{
  "$schema": "https://raw.githubusercontent.com/openwebide/plugins/main/schemas/plugin.schema.json",
  "schemaVersion": 1,
  "publisher": "openwebide",
  "name": "python",
  "version": "0.2.0",
  "displayName": "Python",
  "description": "Python syntax and code intelligence through Pyright on the project execution host.",
  "license": "MIT",
  "compatibility": {
    "pluginApi": 6
  },
  "readme": "README.md",
  "executable": {
    "manifest": "Cargo.toml",
    "library": "language_python",
    "sdkVersion": "0.1.0",
    "capabilities": []
  },
  "contributions": {
    "skills": [],
    "languages": [
      {
        "id": "python",
        "name": "Python",
        "extensions": [
          "py",
          "pyi"
        ],
        "configuration": {
          "uniformLineComments": true,
          "lineComment": "#",
          "brackets": [
            {
              "open": "(",
              "close": ")"
            },
            {
              "open": "[",
              "close": "]"
            },
            {
              "open": "{",
              "close": "}"
            }
          ],
          "autoClosingPairs": [
            {
              "open": "(",
              "close": ")",
              "notIn": [
                "String",
                "Template",
                "Text",
                "LineComment",
                "BlockComment",
                "Regex"
              ]
            },
            {
              "open": "[",
              "close": "]",
              "notIn": [
                "String",
                "Template",
                "Text",
                "LineComment",
                "BlockComment",
                "Regex"
              ]
            },
            {
              "open": "{",
              "close": "}",
              "notIn": [
                "String",
                "Template",
                "Text",
                "LineComment",
                "BlockComment",
                "Regex"
              ]
            },
            {
              "open": "'",
              "close": "'",
              "notIn": [
                "String",
                "Template",
                "Text",
                "LineComment",
                "BlockComment",
                "Regex"
              ],
              "before": "(?:^|[^[:alnum:]_&<])\\z"
            },
            {
              "open": "\"",
              "close": "\"",
              "notIn": [
                "String",
                "Template",
                "Text",
                "LineComment",
                "BlockComment",
                "Regex"
              ]
            }
          ],
          "surroundingPairs": [
            {
              "open": "(",
              "close": ")"
            },
            {
              "open": "[",
              "close": "]"
            },
            {
              "open": "{",
              "close": "}"
            },
            {
              "open": "'",
              "close": "'"
            },
            {
              "open": "\"",
              "close": "\""
            }
          ],
          "indentation": {
            "increase": "[:({\\[]\\z",
            "decrease": "^\\s*[)}\\]]"
          }
        },
        "features": {
          "syntax": true,
          "folding": true,
          "structure": true,
          "languageServer": {
            "command": "pyright-langserver",
            "args": [
              "--stdio"
            ],
            "settings": {
              "python": {
                "analysis": {
                  "diagnosticMode": "openFilesOnly",
                  "autoImportCompletions": true
                }
              }
            }
          }
        },
        "firstLine": "^#!.*\\bpython[0-9.]*\\b"
      }
    ],
    "context": false
  }
}
