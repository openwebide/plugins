{
  "$schema": "https://raw.githubusercontent.com/openwebide/plugins/main/schemas/plugin.schema.json",
  "schemaVersion": 1,
  "publisher": "openwebide",
  "name": "go",
  "version": "0.3.0",
  "displayName": "Go",
  "description": "Go syntax and code intelligence through gopls on the project execution host.",
  "license": "MIT",
  "compatibility": {
    "pluginApi": 9
  },
  "readme": "README.md",
  "executable": {
    "manifest": "Cargo.toml",
    "library": "language_go",
    "sdkVersion": "0.1.0",
    "capabilities": []
  },
  "contributions": {
    "skills": [],
    "languages": [
      {
        "id": "go",
        "name": "Go",
        "extensions": [
          "go"
        ],
        "configuration": {
          "uniformLineComments": true,
          "lineComment": "//",
          "blockComment": {
            "open": "/*",
            "close": "*/",
            "nested": false
          },
          "brackets": [
            {
              "open": "(",
              "close": ")"
            },
            {
              "open": "[",
              "close": "]"
            },
            {
              "open": "{",
              "close": "}"
            }
          ],
          "autoClosingPairs": [
            {
              "open": "(",
              "close": ")",
              "notIn": [
                "String",
                "Template",
                "Text",
                "LineComment",
                "BlockComment",
                "Regex"
              ]
            },
            {
              "open": "[",
              "close": "]",
              "notIn": [
                "String",
                "Template",
                "Text",
                "LineComment",
                "BlockComment",
                "Regex"
              ]
            },
            {
              "open": "{",
              "close": "}",
              "notIn": [
                "String",
                "Template",
                "Text",
                "LineComment",
                "BlockComment",
                "Regex"
              ]
            },
            {
              "open": "'",
              "close": "'",
              "notIn": [
                "String",
                "Template",
                "Text",
                "LineComment",
                "BlockComment",
                "Regex"
              ],
              "before": "(?:^|[^[:alnum:]_&<])\\z"
            },
            {
              "open": "\"",
              "close": "\"",
              "notIn": [
                "String",
                "Template",
                "Text",
                "LineComment",
                "BlockComment",
                "Regex"
              ]
            },
            {
              "open": "`",
              "close": "`",
              "notIn": [
                "String",
                "Template",
                "Text",
                "LineComment",
                "BlockComment",
                "Regex"
              ]
            }
          ],
          "surroundingPairs": [
            {
              "open": "(",
              "close": ")"
            },
            {
              "open": "[",
              "close": "]"
            },
            {
              "open": "{",
              "close": "}"
            },
            {
              "open": "'",
              "close": "'"
            },
            {
              "open": "\"",
              "close": "\""
            },
            {
              "open": "`",
              "close": "`"
            }
          ],
          "indentation": {
            "increase": "[({\\[]\\z",
            "decrease": "^\\s*[)}\\]]"
          }
        },
        "features": {
          "syntax": true,
          "folding": true,
          "structure": true,
          "languageServer": {
            "command": "gopls",
            "args": [
              "serve"
            ],
            "cache": {
              "versionArgs": [
                "version"
              ],
              "environment": {
                "GOPLSCACHE": "${cache}/gopls",
                "GOCACHE": "${cache}/build",
                "GOMODCACHE": "${cache}/modules"
              }
            },
            "projectInputs": {
              "files": [
                "**/go.mod",
                "**/go.sum",
                "go.work",
                "go.work.sum",
                ".go-version",
                ".tool-versions"
              ],
              "exclude": [
                "vendor/**",
                "node_modules/**"
              ]
            }
          }
        }
      }
    ],
    "context": false
  }
}
