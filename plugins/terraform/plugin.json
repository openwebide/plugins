{
  "$schema": "https://raw.githubusercontent.com/openwebide/plugins/main/schemas/plugin.schema.json",
  "schemaVersion": 1,
  "publisher": "openwebide",
  "name": "terraform",
  "version": "0.1.0",
  "displayName": "Terraform",
  "description": "Terraform and related HCL dialects with plugin-owned syntax and terraform-ls code intelligence.",
  "license": "MIT",
  "compatibility": {
    "pluginApi": 9
  },
  "readme": "README.md",
  "executable": {
    "manifest": "Cargo.toml",
    "library": "language_terraform",
    "sdkVersion": "0.1.0",
    "capabilities": []
  },
  "contributions": {
    "skills": [],
    "languages": [
      {
        "id": "terraform",
        "name": "Terraform",
        "extensions": [
          "tf"
        ],
        "configuration": {
          "uniformLineComments": true,
          "lineComment": "#",
          "blockComment": {
            "open": "/*",
            "close": "*/",
            "nested": false
          },
          "brackets": [
            {
              "open": "(",
              "close": ")"
            },
            {
              "open": "[",
              "close": "]"
            },
            {
              "open": "{",
              "close": "}"
            }
          ],
          "autoClosingPairs": [
            {
              "open": "(",
              "close": ")",
              "notIn": [
                "String",
                "Template",
                "Text",
                "LineComment",
                "BlockComment",
                "Regex"
              ]
            },
            {
              "open": "[",
              "close": "]",
              "notIn": [
                "String",
                "Template",
                "Text",
                "LineComment",
                "BlockComment",
                "Regex"
              ]
            },
            {
              "open": "{",
              "close": "}",
              "notIn": [
                "String",
                "Template",
                "Text",
                "LineComment",
                "BlockComment",
                "Regex"
              ]
            },
            {
              "open": "\"",
              "close": "\"",
              "notIn": [
                "String",
                "Template",
                "Text",
                "LineComment",
                "BlockComment",
                "Regex"
              ]
            }
          ],
          "surroundingPairs": [
            {
              "open": "(",
              "close": ")"
            },
            {
              "open": "[",
              "close": "]"
            },
            {
              "open": "{",
              "close": "}"
            },
            {
              "open": "\"",
              "close": "\""
            }
          ],
          "indentation": {
            "increase": "[({\\[]\\z",
            "decrease": "^\\s*[)}\\]]"
          }
        },
        "features": {
          "syntax": true,
          "folding": true,
          "structure": true,
          "languageServer": {
            "command": "terraform-ls",
            "args": [
              "serve"
            ],
            "projectInputs": {
              "files": [
                "**/.terraform.lock.hcl",
                "**/.terraform/modules/modules.json",
                ".terraform-version",
                ".tool-versions"
              ],
              "exclude": [
                ".git/**",
                "**/.terraform/providers/**"
              ]
            },
            "languageId": "terraform"
          }
        }
      },
