{
  "$schema": "https://raw.githubusercontent.com/openwebide/plugins/main/schemas/plugin.schema.json",
  "schemaVersion": 1,
  "publisher": "openwebide",
  "name": "rust",
  "version": "0.3.0",
  "displayName": "Rust",
  "description": "Rust syntax and code intelligence through rust-analyzer on the project execution host.",
  "license": "MIT",
  "compatibility": {
    "pluginApi": 9
  },
  "readme": "README.md",
  "executable": {
    "manifest": "Cargo.toml",
    "library": "language_rust",
    "sdkVersion": "0.1.0",
    "capabilities": []
  },
  "contributions": {
    "skills": [],
    "languages": [
      {
        "id": "rust",
        "name": "Rust",
        "extensions": [
          "rs"
        ],
        "configuration": {
          "uniformLineComments": true,
          "lineComment": "//",
          "blockComment": {
            "open": "/*",
            "close": "*/",
            "nested": true
          },
          "brackets": [
            {
              "open": "(",
              "close": ")"
            },
            {
              "open": "[",
              "close": "]"
            },
            {
              "open": "{",
              "close": "}"
            }
          ],
          "autoClosingPairs": [
            {
              "open": "(",
              "close": ")",
              "notIn": [
                "String",
                "Template",
                "Text",
                "LineComment",
                "BlockComment",
                "Regex"
              ]
            },
            {
              "open": "[",
              "close": "]",
              "notIn": [
                "String",
                "Template",
                "Text",
                "LineComment",
                "BlockComment",
                "Regex"
              ]
            },
            {
              "open": "{",
              "close": "}",
              "notIn": [
                "String",
                "Template",
                "Text",
                "LineComment",
                "BlockComment",
                "Regex"
              ]
            },
            {
              "open": "\"",
              "close": "\"",
              "notIn": [
                "String",
                "Template",
                "Text",
                "LineComment",
                "BlockComment",
                "Regex"
              ]
            }
          ],
          "surroundingPairs": [
            {
              "open": "(",
              "close": ")"
            },
            {
              "open": "[",
              "close": "]"
            },
            {
              "open": "{",
              "close": "}"
            },
            {
              "open": "'",
              "close": "'"
            },
            {
              "open": "\"",
              "close": "\""
            }
          ],
          "indentation": {
            "increase": "[({\\[]\\z",
            "decrease": "^\\s*[)}\\]]"
          }
        },
        "features": {
          "syntax": true,
          "folding": true,
          "structure": true,
          "languageServer": {
            "command": "rust-analyzer",
            "rootMarkers": [
              "Cargo.toml",
              "rust-project.json"
            ],
            "initializationOptions": {
              "files": {
                "watcher": "server"
              }
            },
            "settings": {
              "rust-analyzer": {
                "files": {
                  "watcher": "server"
                }
              }
            },
            "cache": {
              "versionArgs": [
                "--version"
              ],
              "environment": {
                "CARGO_TARGET_DIR": "${cache}/cargo"
              }
            },
            "projectInputs": {
              "files": [
                "**/Cargo.toml",
                "**/Cargo.lock",
                "**/.cargo/config",
                "**/.cargo/config.toml",
                "**/rust-toolchain",
                "**/rust-toolchain.toml",
                "**/rust-analyzer.toml"
              ],
              "exclude": [
                "target/**",
                "node_modules/**"
              ]
            }
          }
        }
      }
    ],
    "context": false
  }
}
