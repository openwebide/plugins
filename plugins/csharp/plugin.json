{
  "$schema": "https://raw.githubusercontent.com/openwebide/plugins/main/schemas/plugin.schema.json",
  "schemaVersion": 1,
  "publisher": "openwebide",
  "name": "csharp",
  "version": "0.2.0",
  "displayName": "C#",
  "description": "C# syntax and code intelligence through csharp-ls on the project execution host.",
  "license": "MIT",
  "compatibility": {
    "pluginApi": 8
  },
  "readme": "README.md",
  "executable": {
    "manifest": "Cargo.toml",
    "library": "language_csharp",
    "sdkVersion": "0.1.0",
    "capabilities": []
  },
  "contributions": {
    "skills": [],
    "languages": [
      {
        "id": "csharp",
        "name": "C#",
        "extensions": [
          "cs"
        ],
        "configuration": {
          "uniformLineComments": true,
          "lineComment": "//",
          "blockComment": {
            "open": "/*",
            "close": "*/",
            "nested": false
          },
          "brackets": [
            {
              "open": "(",
              "close": ")"
            },
            {
              "open": "[",
              "close": "]"
            },
            {
              "open": "{",
              "close": "}"
            }
          ],
          "autoClosingPairs": [
            {
              "open": "(",
              "close": ")",
              "notIn": [
                "String",
                "Template",
                "Text",
                "LineComment",
                "BlockComment",
                "Regex"
              ]
            },
            {
              "open": "[",
              "close": "]",
              "notIn": [
                "String",
                "Template",
                "Text",
                "LineComment",
                "BlockComment",
                "Regex"
              ]
            },
            {
              "open": "{",
              "close": "}",
              "notIn": [
                "String",
                "Template",
                "Text",
                "LineComment",
                "BlockComment",
                "Regex"
              ]
            },
            {
              "open": "'",
              "close": "'",
              "notIn": [
                "String",
                "Template",
                "Text",
                "LineComment",
                "BlockComment",
                "Regex"
              ],
              "before": "(?:^|[^[:alnum:]_&<])\\z"
            },
            {
              "open": "\"",
              "close": "\"",
              "notIn": [
                "String",
                "Template",
                "Text",
                "LineComment",
                "BlockComment",
                "Regex"
              ]
            }
          ],
          "surroundingPairs": [
            {
              "open": "(",
              "close": ")"
            },
            {
              "open": "[",
              "close": "]"
            },
            {
              "open": "{",
              "close": "}"
            },
            {
              "open": "'",
              "close": "'"
            },
            {
              "open": "\"",
              "close": "\""
            }
          ],
          "indentation": {
            "increase": "[({\\[]\\z",
            "decrease": "^\\s*[)}\\]]"
          }
        },
        "features": {
          "syntax": true,
          "folding": true,
          "structure": true,
          "languageServer": {
            "command": "csharp-ls",
            "settings": {
              "csharp": {
                "useMetadataUris": true
              }
            },
            "virtualDocuments": [
              {
                "scheme": "csharp",
                "method": "csharp/metadata",
                "parameters": "text_document",
                "textPointer": "/source"
              }
            ]
          }
        }
      }
    ],
    "context": false
  }
}
