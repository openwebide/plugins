{
  "$schema": "https://raw.githubusercontent.com/openwebide/plugins/main/schemas/plugin.schema.json",
  "schemaVersion": 1,
  "publisher": "openwebide",
  "name": "json",
  "version": "0.2.0",
  "displayName": "JSON and JSONC",
  "description": "JSON and JSONC syntax, schema diagnostics and code intelligence through the JSON language server on the project execution host.",
  "license": "MIT",
  "compatibility": {
    "pluginApi": 7
  },
  "readme": "README.md",
  "executable": {
    "manifest": "Cargo.toml",
    "library": "language_json",
    "sdkVersion": "0.1.0",
    "capabilities": []
  },
  "contributions": {
    "skills": [],
    "languages": [
      {
        "id": "json",
        "name": "JSON",
        "extensions": [
          "json"
        ],
        "configuration": {
          "brackets": [
            {
              "open": "(",
              "close": ")"
            },
            {
              "open": "[",
              "close": "]"
            },
            {
              "open": "{",
              "close": "}"
            }
          ],
          "autoClosingPairs": [
            {
              "open": "(",
              "close": ")",
              "notIn": [
                "String",
                "Template",
                "Text",
                "LineComment",
                "BlockComment",
                "Regex"
              ]
            },
            {
              "open": "[",
              "close": "]",
              "notIn": [
                "String",
                "Template",
                "Text",
                "LineComment",
                "BlockComment",
                "Regex"
              ]
            },
            {
              "open": "{",
              "close": "}",
              "notIn": [
                "String",
                "Template",
                "Text",
                "LineComment",
                "BlockComment",
                "Regex"
              ]
            },
            {
              "open": "\"",
              "close": "\"",
              "notIn": [
                "String",
                "Template",
                "Text",
                "LineComment",
                "BlockComment",
                "Regex"
              ]
            }
          ],
          "surroundingPairs": [
            {
              "open": "(",
              "close": ")"
            },
            {
              "open": "[",
              "close": "]"
            },
            {
              "open": "{",
              "close": "}"
            },
            {
              "open": "\"",
              "close": "\""
            }
          ],
          "indentation": {
            "increase": "[({\\[]\\z",
            "decrease": "^\\s*[)}\\]]"
          }
        },
        "features": {
          "syntax": true,
          "folding": true,
          "structure": true,
          "languageServer": {
            "command": "vscode-json-language-server",
            "args": [
              "--stdio"
            ],
            "rootMarkers": [
              "package.json",
              ".git"
            ],
            "languageId": "json",
            "initializationOptions": {
              "provideFormatter": true
            },
            "settings": {
              "json": {
                "validate": {
                  "enable": true
                },
                "format": {
                  "enable": true
                }
              }
            }
          }
        },
        "filenames": [
          "composer.lock",
          "Pipfile.lock"
        ]
      },
      {
        "id": "jsonc",
        "name": "JSON with Comments",
        "extensions": [
          "jsonc"
        ],
        "configuration": {
          "brackets": [
            {
              "open": "(",
              "close": ")"
            },
            {
              "open": "[",
              "close": "]"
            },
            {
              "open": "{",
              "close": "}"
            }
          ],
          "autoClosingPairs": [
            {
              "open": "(",
              "close": ")",
              "notIn": [
                "String",
                "Template",
                "Text",
                "LineComment",
                "BlockComment",
                "Regex"
              ]
            },
            {
              "open": "[",
              "close": "]",
              "notIn": [
                "String",
                "Template",
                "Text",
                "LineComment",
                "BlockComment",
                "Regex"
              ]
            },
            {
              "open": "{",
              "close": "}",
              "notIn": [
                "String",
                "Template",
                "Text",
                "LineComment",
                "BlockComment",
                "Regex"
              ]
            },
            {
              "open": "\"",
              "close": "\"",
              "notIn": [
                "String",
                "Template",
                "Text",
                "LineComment",
                "BlockComment",
                "Regex"
              ]
            }
          ],
          "surroundingPairs": [
            {
              "open": "(",
              "close": ")"
            },
            {
              "open": "[",
              "close": "]"
            },
            {
              "open": "{",
              "close": "}"
            },
            {
              "open": "\"",
              "close": "\""
            }
          ],
          "indentation": {
            "increase": "[({\\[]\\z",
            "decrease": "^\\s*[)}\\]]"
          },
          "lineComment": "//",
          "uniformLineComments": true,
          "blockComment": {
            "open": "/*",
            "close": "*/",
            "nested": false
          }
        },
        "features": {
          "syntax": true,
          "folding": true,
          "structure": true,
          "languageServer": {
            "command": "vscode-json-language-server",
            "args": [
              "--stdio"
            ],
            "rootMarkers": [
              "package.json",
              ".git"
            ],
            "languageId": "jsonc",
            "initializationOptions": {
              "provideFormatter": true
            },
            "settings": {
              "json": {
                "validate": {
                  "enable": true
                },
                "format": {
                  "enable": true
                }
              }
            }
          }
        }
      }
    ],
    "context": false
  }
}
