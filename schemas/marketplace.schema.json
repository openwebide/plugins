{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/openwebide/plugins/main/schemas/marketplace.schema.json",
  "title": "Marketplace",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/openwebide/plugins/main/schemas/marketplace.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "publisher": {
            "$ref": "https://raw.githubusercontent.com/openwebide/plugins/main/schemas/common.schema.json#/$defs/name"
          },
          "name": {
            "$ref": "https://raw.githubusercontent.com/openwebide/plugins/main/schemas/common.schema.json#/$defs/name"
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "\\S"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "\\S"
          },
          "categories": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "skills",
                "tools"
              ]
            }
          },
          "releases": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "version": {
                  "$ref": "https://raw.githubusercontent.com/openwebide/plugins/main/schemas/common.schema.json#/$defs/version"
                },
                "source": {
                  "$ref": "https://raw.githubusercontent.com/openwebide/plugins/main/schemas/common.schema.json#/$defs/source"
                }
              },
              "required": [
                "version",
                "source"
              ],
              "additionalProperties": false
            }
          },
          "icon": {
            "$ref": "https://raw.githubusercontent.com/openwebide/plugins/main/schemas/common.schema.json#/$defs/icon"
          }
        },
        "required": [
          "publisher",
          "name",
          "displayName",
          "description",
          "categories",
          "releases"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "name",
    "plugins"
  ],
  "additionalProperties": false
}
