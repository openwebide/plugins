{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/openwebide/plugins/main/schemas/panel.schema.json",
  "title": "Plugin panel UI",
  "description": "UI schema version 1, independent of the package manifest and plugin API versions. Hosts also validate aggregate bytes, nesting, identities, action references and revisions.",
  "$defs": {
    "definition": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]{1,64}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "icon": {
          "enum": [
            "puzzle",
            "git_pull_request",
            "list",
            "calendar",
            "activity",
            "book_open",
            "terminal"
          ]
        },
        "view": {
          "type": "string",
          "pattern": "^[a-z0-9_-]{1,64}$"
        },
        "actions": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9_-]{1,64}$"
              },
              "handler": {
                "type": "string",
                "pattern": "^[a-z0-9_-]{1,64}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "requires_approval": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "handler",
              "title",
              "requires_approval"
            ],
            "additionalProperties": false
          }
        },
        "refresh_seconds": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 5,
              "maximum": 3600
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "title",
        "icon",
        "view"
      ],
      "additionalProperties": false
    },
    "block": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "text"
            },
            "text": {
              "type": "string",
              "maxLength": 32768
            }
          },
          "required": [
            "type",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "heading"
            },
            "text": {
              "type": "string",
              "maxLength": 32768
            }
          },
          "required": [
            "type",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "status"
            },
            "text": {
              "type": "string",
              "maxLength": 32768
            },
            "tone": {
              "enum": [
                "neutral",
                "success",
                "warning",
                "error"
              ]
            }
          },
          "required": [
            "type",
            "text",
            "tone"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "group"
            },
            "title": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 128
                },
                {
                  "type": "null"
                }
              ]
            },
            "blocks": {
              "type": "array",
              "maxItems": 256,
              "items": {
                "$ref": "#/$defs/block"
              }
            }
          },
          "required": [
            "type",
            "title",
            "blocks"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "actions"
            },
            "buttons": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "object",
                "properties": {
                  "action": {
                    "type": "string",
                    "pattern": "^[a-z0-9_-]{1,64}$"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "values": {
                    "type": "object",
                    "maxProperties": 32
                  },
                  "disabled": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "action",
                  "label"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "type",
            "buttons"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "form"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9_-]{1,64}$"
            },
            "fields": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9_-]{1,64}$"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "kind": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "const": "text"
                          },
                          "multiline": {
                            "type": "boolean"
                          },
                          "max_length": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 32768
                          }
                        },
                        "required": [
                          "type",
                          "multiline",
                          "max_length"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "const": "checkbox"
                          }
                        },
                        "required": [
                          "type"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "const": "select"
                          },
                          "options": {
                            "type": "array",
                            "minItems": 1,
                            "maxItems": 100,
                            "items": {
                              "type": "object",
                              "properties": {
                                "value": {
                                  "type": "string",
                                  "maxLength": 256
                                },
                                "label": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 256
                                }
                              },
                              "required": [
                                "value",
                                "label"
                              ],
                              "additionalProperties": false
                            }
                          }
                        },
                        "required": [
                          "type",
                          "options"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "const": "secret"
                          },
                          "max_length": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 32768
                          }
                        },
                        "required": [
                          "type",
                          "max_length"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  },
                  "value": {},
                  "required": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "id",
                  "label",
                  "kind"
                ],
                "additionalProperties": false,
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "kind": {
                          "properties": {
                            "type": {
                              "const": "secret"
                            }
                          },
                          "required": [
                            "type"
                          ]
                        }
                      },
                      "required": [
                        "kind"
                      ]
                    },
                    "then": {
                      "properties": {
                        "value": {
                          "type": "null"
                        }
                      }
                    }
                  }
                ]
              }
            },
            "submit": {
              "type": "object",
              "properties": {
                "action": {
                  "type": "string",
                  "pattern": "^[a-z0-9_-]{1,64}$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "values": {
                  "type": "object",
                  "maxProperties": 32
                },
                "disabled": {
                  "type": "boolean"
                }
              },
              "required": [
                "action",
                "label"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "type",
            "id",
            "fields",
            "submit"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "list"
            },
            "items": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "string",
                "maxLength": 8192
              }
            }
          },
          "required": [
            "type",
            "items"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "table"
            },
            "columns": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "string",
                "maxLength": 8192
              }
            },
            "rows": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "string",
                  "maxLength": 8192
                }
              }
            }
          },
          "required": [
            "type",
            "columns",
            "rows"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "code"
            },
            "text": {
              "type": "string",
              "maxLength": 65536
            },
            "language": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 64
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "type",
            "text",
            "language"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "diff"
            },
            "before": {
              "type": "string",
              "maxLength": 65536
            },
            "after": {
              "type": "string",
              "maxLength": 65536
            },
            "path": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 4096
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "type",
            "before",
            "after",
            "path"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "link"
            },
            "text": {
              "type": "string",
              "maxLength": 256
            },
            "url": {
              "type": "string",
              "maxLength": 2048,
              "pattern": "^https?://"
            }
          },
          "required": [
            "type",
            "text",
            "url"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "divider"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "allOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "blocks": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/block"
          }
        },
        "state": {}
      },
      "required": [
        "schema_version",
        "revision",
        "blocks"
      ],
      "additionalProperties": false
    }
  ]
}
