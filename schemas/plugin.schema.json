{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/openwebide/plugins/main/schemas/plugin.schema.json",
  "title": "Plugin",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/openwebide/plugins/main/schemas/plugin.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "publisher": {
      "$ref": "https://raw.githubusercontent.com/openwebide/plugins/main/schemas/common.schema.json#/$defs/name"
    },
    "name": {
      "$ref": "https://raw.githubusercontent.com/openwebide/plugins/main/schemas/common.schema.json#/$defs/name"
    },
    "version": {
      "$ref": "https://raw.githubusercontent.com/openwebide/plugins/main/schemas/common.schema.json#/$defs/version"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "\\S"
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "readme": {
      "$ref": "https://raw.githubusercontent.com/openwebide/plugins/main/schemas/common.schema.json#/$defs/path"
    },
    "compatibility": {
      "type": "object",
      "properties": {
        "pluginApi": {
          "enum": [
            1,
            2,
            3
          ]
        }
      },
      "required": [
        "pluginApi"
      ],
      "additionalProperties": false
    },
    "contributions": {
      "type": "object",
      "properties": {
        "skills": {
          "type": "array",
          "minItems": 0,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "$ref": "https://raw.githubusercontent.com/openwebide/plugins/main/schemas/common.schema.json#/$defs/path"
              }
            },
            "required": [
              "path"
            ],
            "additionalProperties": false
          }
        },
        "toolGroups": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "web",
              "memory",
              "scheduling",
              "skill-authoring"
            ]
          }
        },
        "tools": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z0-9_]+$"
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "\\S"
              },
              "parameters": {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "object"
                  }
                },
                "required": [
                  "type"
                ]
              },
              "requires_approval": {
                "type": "boolean"
              }
            },
            "required": [
              "name",
              "description",
              "parameters",
              "requires_approval"
            ],
            "additionalProperties": false
          }
        },
        "events": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9_]+$"
          }
        },
        "background": {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z0-9_]+$"
            },
            "intervalSeconds": {
              "type": "integer",
              "minimum": 60,
              "maximum": 86400
            }
          },
          "required": [
            "event",
            "intervalSeconds"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "skills"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "properties": {
            "skills": {
              "minItems": 1
            }
          },
          "required": [
            "skills"
          ]
        },
        {
          "properties": {
            "toolGroups": {
              "minItems": 1
            }
          },
          "required": [
            "toolGroups"
          ]
        },
        {
          "properties": {
            "tools": {
              "minItems": 1
            }
          },
          "required": [
            "tools"
          ]
        },
        {
          "properties": {
            "events": {
              "minItems": 1
            }
          },
          "required": [
            "events"
          ]
        }
      ]
    },
    "executable": {
      "type": "object",
      "properties": {
        "manifest": {
          "const": "Cargo.toml"
        },
        "library": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$",
          "minLength": 1,
          "maxLength": 64
        },
        "sdkVersion": {
          "const": "0.1.0"
        },
        "capabilities": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "http",
              "records",
              "collections",
              "jobs",
              "runs",
              "workspace",
              "clock",
              "completion"
            ]
          }
        }
      },
      "required": [
        "manifest",
        "library",
        "sdkVersion",
        "capabilities"
      ],
      "additionalProperties": false
    },
    "icon": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "description": "Optional inline static SVG drawing, using a 0 0 24 24 viewBox and currentColor. The host validates a bounded drawing subset."
    }
  },
  "required": [
    "schemaVersion",
    "publisher",
    "name",
    "version",
    "displayName",
    "description",
    "license",
    "compatibility",
    "contributions"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "contributions": {
            "properties": {
              "toolGroups": {
                "minItems": 1
              }
            },
            "required": [
              "toolGroups"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "compatibility": {
            "properties": {
              "pluginApi": {
                "const": 2
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "compatibility": {
            "properties": {
              "pluginApi": {
                "const": 3
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "executable"
        ],
        "properties": {
          "contributions": {
            "properties": {
              "toolGroups": {
                "maxItems": 0
              }
            }
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "executable"
          ]
        },
        "properties": {
          "contributions": {
            "properties": {
              "tools": {
                "maxItems": 0
              },
              "events": {
                "maxItems": 0
              }
            }
          }
        }
      }
    }
  ]
}
