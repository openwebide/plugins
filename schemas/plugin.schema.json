{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/openwebide/plugins/main/schemas/plugin.schema.json",
  "title": "Plugin",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/openwebide/plugins/main/schemas/plugin.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "publisher": {
      "$ref": "https://raw.githubusercontent.com/openwebide/plugins/main/schemas/common.schema.json#/$defs/name"
    },
    "name": {
      "$ref": "https://raw.githubusercontent.com/openwebide/plugins/main/schemas/common.schema.json#/$defs/name"
    },
    "version": {
      "$ref": "https://raw.githubusercontent.com/openwebide/plugins/main/schemas/common.schema.json#/$defs/version"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "\\S"
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "readme": {
      "$ref": "https://raw.githubusercontent.com/openwebide/plugins/main/schemas/common.schema.json#/$defs/path"
    },
    "compatibility": {
      "type": "object",
      "properties": {
        "pluginApi": {
          "enum": [
            1,
            2
          ]
        }
      },
      "required": [
        "pluginApi"
      ],
      "additionalProperties": false
    },
    "contributions": {
      "type": "object",
      "properties": {
        "skills": {
          "type": "array",
          "minItems": 0,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "$ref": "https://raw.githubusercontent.com/openwebide/plugins/main/schemas/common.schema.json#/$defs/path"
              }
            },
            "required": [
              "path"
            ],
            "additionalProperties": false
          }
        },
        "toolGroups": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "web",
              "memory",
              "scheduling",
              "skill-authoring"
            ]
          }
        }
      },
      "required": [
        "skills"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "properties": {
            "skills": {
              "minItems": 1
            }
          },
          "required": [
            "skills"
          ]
        },
        {
          "properties": {
            "toolGroups": {
              "minItems": 1
            }
          },
          "required": [
            "toolGroups"
          ]
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "publisher",
    "name",
    "version",
    "displayName",
    "description",
    "license",
    "compatibility",
    "contributions"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "contributions": {
            "properties": {
              "toolGroups": {
                "minItems": 1
              }
            },
            "required": [
              "toolGroups"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "compatibility": {
            "properties": {
              "pluginApi": {
                "const": 2
              }
            }
          }
        }
      }
    }
  ]
}
